// Réglages de publication sur Cloudflare (outil « wrangler »).
// Il lui faut savoir quel dossier envoyer : c'est le résultat de "npm run build".
{
  // Nom du projet : doit être identique à celui affiché dans Cloudflare (Workers & Pages → myrpgapp).
  "name": "myrpgapp",
  // Date de référence du moteur Cloudflare : fige son comportement pour que rien ne change tout seul.
  "compatibility_date": "2026-11-13",
  "assets": {
    // Dossier produit par Vite, envoyé tel quel sur le réseau de Cloudflare.
    "directory": "./dist"
  }
}
